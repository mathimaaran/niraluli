// Tamil-0.63: file I/O via கொணர் "கோப்பு".
தொகுப்பு தொடக்கம்

கொணர் "கோப்பு"

செயல்பாடு பிழைகாட்டு(ப *கோப்பு.பிழை) {
    எனில் ப != இன்மை {
        பதிப்பி(ப.செய்தி)
    }
}

செயல்பாடு தொடக்கம்() {
    ப := கோப்பு.எழுதுஅனை("demo.txt", []இருமி8("வணக்கம்"))
    எனில் ப != இன்மை {
        பிழைகாட்டு(ப)
        திருப்பு
    }

    தரவு, ப2 := கோப்பு.படிஅனை("demo.txt")
    எனில் ப2 != இன்மை {
        பிழைகாட்டு(ப2)
        திருப்பு
    }
    பதிப்பி(சரம்(தரவு))

    மாறி க கோப்பு.கை
    க, ப = கோப்பு.உருவாக்கு("demo2.txt")
    எனில் ப != இன்மை {
        பிழைகாட்டு(ப)
        திருப்பு
    }
    _, ப = கோப்பு.எழுது(க, []இருமி8("நிரலுளி"))
    எனில் ப != இன்மை {
        பிழைகாட்டு(ப)
        திருப்பு
    }
    ப = கோப்பு.விடு(க)
    எனில் ப != இன்மை {
        பிழைகாட்டு(ப)
        திருப்பு
    }

    க, ப = கோப்பு.திற("demo2.txt")
    எனில் ப != இன்மை {
        பிழைகாட்டு(ப)
        திருப்பு
    }
    இடம் := ஆக்கு([]இருமி8, 64)
    மாறி n முழுஎண்
    n, ப = கோப்பு.படி(க, இடம்)
    எனில் ப != இன்மை {
        பிழைகாட்டு(ப)
        திருப்பு
    }
    பதிப்பி(சரம்(இடம்[:n]))
    ப = கோப்பு.விடு(க)
    எனில் ப != இன்மை {
        பிழைகாட்டு(ப)
        திருப்பு
    }

    _, ப = கோப்பு.திற("missing-uli-file.txt")
    எனில் ப != இன்மை {
        பதிப்பி(ப.செய்தி)
    }
}
