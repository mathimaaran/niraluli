// Tamil-0.79: time parse, locations, timers via கொணர் "நேரம்".
தொகுப்பு தொடக்கம்

கொணர் "நேரம்"

செயல்பாடு தொடக்கம்() {
    உரை := நேரம்.சரம்ஆக்கு(நேரம்.இப்போ())
    த, ப := நேரம்.பகு(உரை)
    எனில் ப != இன்மை {
        பதிப்பி(ப.செய்தி)
        திருப்பு
    }
    மீண்டும் := நேரம்.சரம்ஆக்கு(த)
    எனில் நீளம்(மீண்டும்) >= 20 {
        பதிப்பி("பகு")
    } இல்லையேல் {
        பதிப்பி(மீண்டும்)
    }

    உள்ளூர் := நேரம்.சரம்ஆக்குஇடம்(த, நேரம்.உள்ளூர்)
    எனில் நீளம்(உள்ளூர்) >= 20 {
        பதிப்பி("உள்ளூர்")
    } இல்லையேல் {
        பதிப்பி(உள்ளூர்)
    }

    ச := நேரம்.பின்னர்(நேரம்.மில்லிவினாடி(25))
    எனில் நேரம்.யூனிக்ஸ்(<-ச) > 0 {
        பதிப்பி("பின்னர்")
    }

    து := நேரம்.துடிப்பு(நேரம்.மில்லிவினாடி(20))
    எனில் நேரம்.யூனிக்ஸ்(<-து) > 0 {
        பதிப்பி("துடிப்பு")
    }
    இரண்டாம் := நேரம்.யூனிக்ஸ்(<-து)
    எனில் இரண்டாம் > 0 {
        பதிப்பி("இரண்டு")
    }
    நிறுத்தியது := நேரம்.நிறுத்து(து)
    எனில் நிறுத்தியது {
        பதிப்பி("நிறுத்து")
    } இல்லையேல் {
        பதிப்பி("தவறு")
    }
}
