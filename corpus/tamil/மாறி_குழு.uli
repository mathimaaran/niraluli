// Tamil-0.73: package-level and block மாறி ( … ) groups.
// Go equivalent:
//
//	package main
//
//	import "fmt"
//
//	var (
//		version int = 1
//		count   int
//		name    = "நிரலுளி"
//	)
//
//	func main() {
//		var (
//			x int = 10
//			y = 20
//		)
//		count = x + y
//		fmt.Println(count)
//		fmt.Println(version)
//		fmt.Println(name)
//	}

தொகுப்பு தொடக்கம்

மாறி (
    பதிப்பு முழுஎண் = 1
    எண் முழுஎண்
    பெயர் = "நிரலுளி"
)

செயல்பாடு தொடக்கம்() {
    மாறி (
        அ முழுஎண் = 10
        ஆ = 20
    )
    எண் = அ + ஆ
    பதிப்பி(எண்)
    பதிப்பி(பதிப்பு)
    பதிப்பி(பெயர்)
}
