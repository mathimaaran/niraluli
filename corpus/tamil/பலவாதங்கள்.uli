// Tamil-0.66: variadic parameters (...T).
// Go equivalent:
//
//	package main
//
//	import "fmt"
//
//	func sum(xs ...int) int {
//		n := 0
//		for _, v := range xs {
//			n += v
//		}
//		return n
//	}
//
//	func main() {
//		fmt.Println(sum())
//		fmt.Println(sum(1, 2, 3))
//	}

தொகுப்பு தொடக்கம்

செயல்பாடு கூட்டு(எண்கள் ...முழுஎண்) முழுஎண் {
    மாறி மொத்தம் முழுஎண் = 0
    சுழல் _, வ := ஒவ்வொரு எண்கள் {
        மொத்தம் = மொத்தம் + வ
    }
    திருப்பு மொத்தம்
}

செயல்பாடு தொடக்கம்() {
    பதிப்பி(கூட்டு())
    பதிப்பி(கூட்டு(1, 2, 3))
    பதிப்பி(கூட்டு(10, 20))
}
