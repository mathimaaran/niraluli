// Tamil-0.75: richer integer widths.
// Go equivalent:
//
//	package main
//
//	import "fmt"
//
//	func main() {
//		var a int8 = 10
//		var b uint16 = 20
//		var c int32 = int32(a) + int32(b)
//		fmt.Println(int64(c))
//		fmt.Println(int64(uint64(255)))
//	}

தொகுப்பு தொடக்கம்

செயல்பாடு தொடக்கம்() {
    மாறி அ முழுஎண்8 = 10
    மாறி ஆ நேர்முழு16 = 20
    மாறி இ முழுஎண்32 = முழுஎண்32(அ) + முழுஎண்32(ஆ)
    பதிப்பி(முழுஎண்(இ))
    பதிப்பி(முழுஎண்(நேர்முழு64(255)))
    பதிப்பி(முழுஎண்(இருமி8(7)))
}
