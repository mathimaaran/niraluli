// Niraluli: தகவல்_வலை — UDP loopback (Tamil-0.61)
தொகுப்பு தொடக்கம்

கொணர் "வலை"

செயல்பாடு பிழைகாட்டு(ப *வலை.பிழை) {
    எனில் ப != இன்மை {
        பதிப்பி(ப.செய்தி)
    }
}

செயல்பாடு தொடக்கம்() {
    சேவை, ப := வலை.தகவல்கேள்("127.0.0.1:0")
    எனில் ப != இன்மை {
        பிழைகாட்டு(ப)
        திருப்பு
    }
    முகவரி, ப2 := வலை.தகவல்முகவரி(சேவை)
    எனில் ப2 != இன்மை {
        பிழைகாட்டு(ப2)
        திருப்பு
    }

    முடிவு := ஆக்கு(தடம் நிலை, 1)
    இழை செயல்பாடு() {
        இடம் := ஆக்கு([]இருமி8, 64)
        n, அனுப்பியவர், ப3 := வலை.தகவல்பெறு(சேவை, இடம்)
        எனில் ப3 != இன்மை {
            பிழைகாட்டு(ப3)
            முடிவு <- பொய்
            திருப்பு
        }
        பதிப்பி(சரம்(இடம்[:n]))
        _, ப3 = வலை.தகவலனுப்பு(சேவை, அனுப்பியவர், []இருமி8("pong"))
        எனில் ப3 != இன்மை {
            பிழைகாட்டு(ப3)
            முடிவு <- பொய்
            திருப்பு
        }
        முடிவு <- மெய்
    }()

    வாடிக்கையாளர், ப4 := வலை.தகவல்கேள்("127.0.0.1:0")
    எனில் ப4 != இன்மை {
        பிழைகாட்டு(ப4)
        திருப்பு
    }
    _, ப4 = வலை.தகவலனுப்பு(வாடிக்கையாளர், முகவரி, []இருமி8("ping"))
    எனில் ப4 != இன்மை {
        பிழைகாட்டு(ப4)
        திருப்பு
    }
    இடம் := ஆக்கு([]இருமி8, 64)
    மாறி n முழுஎண்
    n, _, ப4 = வலை.தகவல்பெறு(வாடிக்கையாளர், இடம்)
    எனில் ப4 != இன்மை {
        பிழைகாட்டு(ப4)
        திருப்பு
    }
    பதிப்பி(சரம்(இடம்[:n]))

    முடிந்தது := <-முடிவு
    எனில் !முடிந்தது {
        திருப்பு
    }
    வலை.தகவல்விடு(வாடிக்கையாளர்)
    வலை.தகவல்விடு(சேவை)
}
