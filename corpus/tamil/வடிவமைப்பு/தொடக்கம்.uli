// Tamil-0.66/0.77: fmt-style formatting via கொணர் "வடிவம்".
// Go equivalent:
//
//	package main
//
//	import (
//		"fmt"
//		"strings"
//	)
//
//	func main() {
//		fmt.Println(fmt.Sprintf("வணக்கம், %s!", "நிரலுளி"))
//		fmt.Println(fmt.Sprintf("எண்=%d நிலை=%t", 42, true))
//		fmt.Println(fmt.Sprintf("மிதவை=%g", 1.5))
//		fmt.Println(fmt.Sprintf("சதவீதம் %%s = %s", "ok"))
//		fmt.Println(strings.Join([]string{"அ", "ஆ", "இ"}, "-"))
//		fmt.Println(fmt.Sprintf("missing %s %s", "only"))
//		fmt.Println(fmt.Sprintf("any=%v", 7))
//	}

தொகுப்பு தொடக்கம்

கொணர் "வடிவம்"

செயல்பாடு தொடக்கம்() {
    பதிப்பி(வடிவம்.வடிவமை("வணக்கம், %s!", "நிரலுளி"))
    பதிப்பி(வடிவம்.வடிவமை("எண்=%d நிலை=%t", 42, மெய்))
    பதிப்பி(வடிவம்.வடிவமை("மிதவை=%g", 1.5))
    பதிப்பி(வடிவம்.வடிவமை("சதவீதம் %%s = %s", "ok"))
    பதிப்பி(வடிவம்.இணை([]சரம்{"அ", "ஆ", "இ"}, "-"))
    பதிப்பி(வடிவம்.வடிவமை("missing %s %s", "only"))
    பதிப்பி(வடிவம்.வடிவமை("any=%v", 7))
}
