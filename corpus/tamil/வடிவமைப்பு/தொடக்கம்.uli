// Tamil-0.66: fmt-style formatting via கொணர் "வடிவம்" (variadic ...சரம்).
// Go equivalent:
//
//	package main
//
//	import (
//		"fmt"
//		"strconv"
//		"strings"
//	)
//
//	func main() {
//		fmt.Println(fmt.Sprintf("வணக்கம், %s!", "நிரலுளி"))
//		fmt.Println(fmt.Sprintf("எண்=%s நிலை=%s", strconv.Itoa(42), strconv.FormatBool(true)))
//		fmt.Println(fmt.Sprintf("மிதவை=%s", strconv.FormatFloat(1.5, 'g', -1, 64)))
//		fmt.Println(fmt.Sprintf("சதவீதம் %%s = %s", "ok"))
//		fmt.Println(strings.Join([]string{"அ", "ஆ", "இ"}, "-"))
//		fmt.Println(fmt.Sprintf("missing %s %s", "only")) // Go also inserts %!s(MISSING)
//	}
//
// Notes: verbs are still %s/%% only; convert scalars with *உரை helpers. மெய் ≈ true.

தொகுப்பு தொடக்கம்

கொணர் "வடிவம்"

செயல்பாடு தொடக்கம்() {
    பதிப்பி(வடிவம்.வடிவமை("வணக்கம், %s!", "நிரலுளி"))
    பதிப்பி(வடிவம்.வடிவமை("எண்=%s நிலை=%s", வடிவம்.எண்உரை(42), வடிவம்.நிலைஉரை(மெய்)))
    பதிப்பி(வடிவம்.வடிவமை("மிதவை=%s", வடிவம்.மிதவைஉரை(1.5)))
    பதிப்பி(வடிவம்.வடிவமை("சதவீதம் %%s = %s", "ok"))
    பதிப்பி(வடிவம்.இணை([]சரம்{"அ", "ஆ", "இ"}, "-"))
    பதிப்பி(வடிவம்.வடிவமை("missing %s %s", "only"))
}
