// Tamil-0.81: PostgreSQL backend (skip if libpq/DSN unavailable).
தொகுப்பு தொடக்கம்

கொணர் "தரவுத்தளம்"

செயல்பாடு தொடக்கம்() {
    இ, ப := தரவுத்தளம்.திற("postgres", "host=127.0.0.1 port=5432 dbname=uli user=uli password=uli connect_timeout=1")
    எனில் ப != இன்மை {
        பதிப்பி("தவிர்")
        பதிப்பி(ப.செய்தி)
        திருப்பு
    }

    _, ப = தரவுத்தளம்.செயல்(இ, "CREATE TEMP TABLE பொருள் (எண் BIGINT, பெயர் TEXT, மதிப்பு DOUBLE PRECISION, தரவு BYTEA, குறிப்பு TEXT)")
    எனில் ப != இன்மை {
        பதிப்பி(ப.செய்தி)
        திருப்பு
    }

    க, ப2 := தரவுத்தளம்.தயாரி(இ, "INSERT INTO பொருள் VALUES ($1, $2, $3, $4, $5)")
    எனில் ப2 != இன்மை {
        பதிப்பி(ப2.செய்தி)
        திருப்பு
    }
    ப = தரவுத்தளம்.முழுஎண்பிணை(க, 1, 1)
    ப = தரவுத்தளம்.சரம்பிணை(க, 2, "நிரலுளி")
    ப = தரவுத்தளம்.மிதவைப்பிணை(க, 3, 9.5)
    ப = தரவுத்தளம்.இருமிப்பிணை(க, 4, []இருமி8("தரவு"))
    ப = தரவுத்தளம்.இன்மைபிணை(க, 5)
    _, ப = தரவுத்தளம்.அடுத்து(க)
    எனில் ப != இன்மை {
        பதிப்பி(ப.செய்தி)
        திருப்பு
    }
    ப = தரவுத்தளம்.கூற்றுவிடு(க)

	க, ப = தரவுத்தளம்.தயாரி(இ, "SELECT எண், பெயர், மதிப்பு, தரவு, குறிப்பு FROM பொருள்")
    எனில் ப != இன்மை {
        பதிப்பி(ப.செய்தி)
        திருப்பு
    }
    மாறி உண்டு நிலை
    உண்டு, ப = தரவுத்தளம்.அடுத்து(க)
    எனில் ப != இன்மை {
        பதிப்பி(ப.செய்தி)
        திருப்பு
    }
    எனில் உண்டு {
        எண், _ := தரவுத்தளம்.முழுஎண்பெறு(க, 0)
        உரை, _ := தரவுத்தளம்.சரம்பெறு(க, 1)
        பதிப்பி(எண்)
        பதிப்பி(உரை)
    }
    ப = தரவுத்தளம்.கூற்றுவிடு(க)
    ப = தரவுத்தளம்.விடு(இ)
    பதிப்பி("சரி")
}
