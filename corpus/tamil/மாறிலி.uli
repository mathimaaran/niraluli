// Tamil-0.67: compile-time constants (மாறிலி).
// Go equivalent:
//
//	package main
//
//	import "fmt"
//
//	const max = 10
//	const greet = "வணக்கம்"
//
//	func main() {
//		const twice = max * 2
//		const a, b int = 1, 2
//		fmt.Println(twice)
//		fmt.Println(greet)
//		fmt.Println(a)
//		fmt.Println(b)
//		fmt.Println(max > 5)
//	}

தொகுப்பு தொடக்கம்

மாறிலி அதிகம் முழுஎண் = 10
மாறிலி வாழ்த்து = "வணக்கம்"

செயல்பாடு தொடக்கம்() {
    மாறிலி இரட்டி = அதிகம் * 2
    மாறிலி அ, ஆ முழுஎண் = 1, 2
    பதிப்பி(இரட்டி)
    பதிப்பி(வாழ்த்து)
    பதிப்பி(அ)
    பதிப்பி(ஆ)
    பதிப்பி(அதிகம் > 5)
}
