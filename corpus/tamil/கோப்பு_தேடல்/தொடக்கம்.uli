// Tamil-0.78: file seek, mkdir, readdir, chmod via கொணர் "கோப்பு".
தொகுப்பு தொடக்கம்

கொணர் "கோப்பு"

செயல்பாடு பிழைகாட்டு(ப *கோப்பு.பிழை) {
    எனில் ப != இன்மை {
        பதிப்பி(ப.செய்தி)
    }
}

செயல்பாடு தொடக்கம்() {
    ப := கோப்பு.எழுதுஅனை("seek.txt", []இருமி8("ABCDEFGH"))
    எனில் ப != இன்மை {
        பிழைகாட்டு(ப)
        திருப்பு
    }
    க, ப2 := கோப்பு.திற("seek.txt")
    எனில் ப2 != இன்மை {
        பிழைகாட்டு(ப2)
        திருப்பு
    }
    _, ப = கோப்பு.தேடு(க, 2, கோப்பு.தேடுதொடக்கம்)
    எனில் ப != இன்மை {
        பிழைகாட்டு(ப)
        திருப்பு
    }
    இடம் := ஆக்கு([]இருமி8, 8)
    மாறி n முழுஎண்
    n, ப = கோப்பு.படி(க, இடம்)
    எனில் ப != இன்மை {
        பிழைகாட்டு(ப)
        திருப்பு
    }
    பதிப்பி(சரம்(இடம்[:n]))
    ப = கோப்பு.விடு(க)
    எனில் ப != இன்மை {
        பிழைகாட்டு(ப)
        திருப்பு
    }

    // 0755 octal = 493; 0600 octal = 384
    ப = கோப்பு.அடைவுஉருவாக்கு("uli_dir", 493)
    எனில் ப != இன்மை {
        பிழைகாட்டு(ப)
        திருப்பு
    }
    ப = கோப்பு.எழுதுஅனை("uli_dir/demo.txt", []இருமி8("x"))
    எனில் ப != இன்மை {
        பிழைகாட்டு(ப)
        திருப்பு
    }
    ப = கோப்பு.அனுமதிமாற்று("uli_dir/demo.txt", 384)
    எனில் ப != இன்மை {
        பிழைகாட்டு(ப)
        திருப்பு
    }
    பதிப்பி("சரி")

    பெயர்கள், ப3 := கோப்பு.அடைவுபடி("uli_dir")
    எனில் ப3 != இன்மை {
        பிழைகாட்டு(ப3)
        திருப்பு
    }
    சுழல் _, பெயர் := ஒவ்வொரு பெயர்கள் {
        பதிப்பி(பெயர்)
    }
}
