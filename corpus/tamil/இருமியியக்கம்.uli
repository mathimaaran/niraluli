// Tamil-0.74: bitwise and shift operators; iota bit flags.
// Go equivalent:
//
//	package main
//
//	import "fmt"
//
//	const (
//		read = 1 << iota
//		write
//		exec
//	)
//
//	func main() {
//		fmt.Println(read | write)
//		fmt.Println(7 &^ write)
//		fmt.Println(^0 + 1)
//		fmt.Println(1 << 3)
//		fmt.Println(exec)
//	}

தொகுப்பு தொடக்கம்

மாறிலி (
    வாசி = 1 << iota
    எழுது
    இயக்கு
)

செயல்பாடு தொடக்கம்() {
    பதிப்பி(வாசி | எழுது)
    பதிப்பி(7 &^ எழுது)
    பதிப்பி(^0 + 1)
    பதிப்பி(1 << 3)
    பதிப்பி(இயக்கு)
}
